APP_NAME=MediaForge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Producción en contenedores: LOG_STACK=json (JSON por línea en stderr, visible con docker compose logs)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediaforgeapi
DB_USERNAME=mediaforge
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=secret
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker (compose.yaml) ---
APP_BUILD_TARGET=dev
APP_PORT=8081
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380
DB_ROOT_PASSWORD=root
HOST_UID=1000
HOST_GID=1000
RUN_MIGRATIONS=true
QUEUE_NAMES=media-high,media,media-low,default
QUEUE_TIMEOUT=3600
QUEUE_TRIES=3
REDIS_QUEUE_RETRY_AFTER=3700
REDIS_QUEUE_BLOCK_FOR=1
REDIS_QUEUE_AFTER_COMMIT=true

# Webhooks (en producción solo https; allowed_hosts omite la protección SSRF, úsalo solo para hosts internos de confianza)
MEDIAFORGE_WEBHOOK_QUEUE=webhooks
# MEDIAFORGE_WEBHOOK_ALLOW_HTTP=false  # por defecto: true fuera de producción
MEDIAFORGE_WEBHOOK_ALLOWED_PORTS=443,80,8443
MEDIAFORGE_WEBHOOK_ALLOWED_HOSTS=
